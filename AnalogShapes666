local Pool = {}
Pool.__index = Pool

function Pool.new(adornee)
    return setmetatable({ adornee = adornee, items = {}, used = 0 }, Pool)
end

function Pool:_make()
    local gui = Instance.new("BillboardGui")
    gui.Adornee = self.adornee
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.Size = UDim2.fromScale(1, 1)
    gui.Enabled = false

    local img = Instance.new("ImageLabel")
    img.BackgroundTransparency = 1
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.fromScale(0.5, 0.5)
    img.Size = UDim2.fromScale(1, 1)
    img.Image = MARKER_IMAGE
    img.Parent = gui

    gui.Parent = self.adornee

    local item = { gui = gui, img = img }
    table.insert(self.items, item)
    return item
end

function Pool:Begin()
    self.used = 0
end

function Pool:Add(offset, size, alpha, rotation)
    self.used += 1
    local item = self.items[self.used] or self:_make()
    item.gui.Enabled = true
    item.gui.StudsOffsetWorldSpace = offset
    item.gui.Size = UDim2.fromScale(size, size)
    item.img.ImageTransparency = 1 - math.clamp(alpha, 0, 1)
    item.img.ImageColor3 = targetesp.Color
    item.img.Rotation = rotation or 0
end

function Pool:End()
    for i = self.used + 1, #self.items do
        local it = self.items[i]
        if it.gui.Enabled then
            it.gui.Enabled = false
        end
    end
end

local pool = Pool.new(anchor)
local anim = Animation.new(0.4)
local targetEspModel = nil
local lastTargetEsp = nil
local rotAngle = 0
local rotSpeed = 0
local reversing = false

function targetesp.SetTarget(model)
    if targetEspModel ~= model then
        targetEspModel = model
    end
end

RunService.RenderStepped:Connect(function(dt)
    if not targetesp.Enabled then
        pool:Begin()
        pool:End()
        return
    end

    local has = targetEspModel ~= nil and targetEspModel.Parent ~= nil
    if has then
        lastTargetEsp = targetEspModel
    end

    anim:update(dt, has)

    if not has and anim.value <= 0 then
        lastTargetEsp = nil
    end

    pool:Begin()

    if lastTargetEsp and lastTargetEsp.Parent and anim.value > 0.01 then
        local cf = lastTargetEsp:GetBoundingBox()
        anchor.Position = cf.Position

        local k = dt * 60
        if not reversing then
            rotSpeed += 0.01 * k
            if rotSpeed > 2.3 then
                rotSpeed = 2.3
                reversing = true
            end
        else
            rotSpeed -= 0.01 * k
            if rotSpeed < -2.3 then
                rotSpeed = -2.3
                reversing = false
            end
        end
        rotAngle = (rotAngle + rotSpeed * k) % 360

        pool:Add(Vector3.zero, 1.8 * anim.value * SCALE, anim.value, rotAngle)
    end

    pool:End()
end)

