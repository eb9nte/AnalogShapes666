local function resetPetal(part, hrpPos)
    local randX = math.random(-120, 120)
    local randZ = math.random(-120, 120)
    part.Position = hrpPos + Vector3.new(randX, math.random(35, 60), randZ)
    part.AssemblyLinearVelocity = Vector3.new(math.random(-3, 3), -7, math.random(-3, 3))
    part.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-3, 3), math.random(-5, 5))
end

local function updatePetalsPool()
    for _, p in ipairs(petals_pool) do if p.Part then p.Part:Destroy() end end
    table.clear(petals_pool)
    if not Options.SakuraToggle or not Options.SakuraToggle.Value then return end
    
    local count = Options.SakuraCountSlider and Options.SakuraCountSlider.Value or 130
    local color = Options.SakuraColorPicker and Options.SakuraColorPicker.Value or Color3.fromRGB(255, 230, 240)
    
    for i = 1, count do
        local part = Instance.new("Part", MainFolder)
        part.Name = "SakuraPetal"
        part.Shape = Enum.PartType.Cylinder
        part.Size = Vector3.new(0.02, 0.5, 0.9)
        part.Orientation = Vector3.new(0, 0, 90)
        part.Color = color
        part.Material = Enum.Material.Neon
        part.Transparency = 0.35
        part.CanCollide = false
        part.Anchored = false
        
        local bf = Instance.new("BodyForce", part)
        bf.Force = Vector3.new(0, part:GetMass() * (workspace.Gravity - 7), 0)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            resetPetal(part, char.HumanoidRootPart.Position)
        end
        table.insert(petals_pool, {Part = part, SpawnTime = tick()})
    end
end

local function drawLightningBolt(startPos, endPos, color)
    local segments = 8
    local lastPos = startPos
    for i = 1, segments do
        local progress = i / segments
        local offset = Vector3.new(math.random(-5, 5), math.random(-2, 2), math.random(-5, 5))
        if i == segments then offset = Vector3.new(0,0,0) end
        local targetPos = startPos:Lerp(endPos, progress) + offset
        
        local segPart = Instance.new("Part", MainFolder)
        segPart.Size = Vector3.new(0.3, 0.3, (targetPos - lastPos).Magnitude)
        segPart.CFrame = CFrame.new(lastPos:Lerp(targetPos, 0.5), targetPos)
        segPart.Color = color
        segPart.Material = Enum.Material.Neon
        segPart.Anchored = true
        segPart.CanCollide = false
        game:GetService("Debris"):AddItem(segPart, 0.4)
        lastPos = targetPos
    end
    local lightPart = Instance.new("Part", MainFolder)
    lightPart.Position = endPos
    lightPart.Transparency = 1
    lightPart.Anchored = true
    lightPart.CanCollide = false
    local pl = Instance.new("PointLight", lightPart)
    pl.Color = color
    pl.Range = 40
    pl.Brightness = 8
    game:GetService("Debris"):AddItem(lightPart, 0.3)
end

