RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- RGB обновление скорости и цветов «на лету» без лагов и пересоздания объектов
    local rgbSpeed = Options.RGBSpeedSlider and Options.RGBSpeedSlider.Value or 1
    rgbHue = (rgbHue + dt * (rgbSpeed * 0.1)) % 1
    local currentRgbColor = Color3.fromHSV(rgbHue, 1, 1)

    if Options.ChinaHatRGBToggle and Options.ChinaHatRGBToggle.Value then
        local hat = char:FindFirstChild("CustomChinaHat")
        if hat then
            hat.Color = currentRgbColor
            local pl = hat:FindFirstChildOfClass("PointLight")
            if pl then pl.Color = currentRgbColor end
        end
    end

    if Options.TrailRGBToggle and Options.TrailRGBToggle.Value then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local trail = part:FindFirstChild("CustomCheatTrail")
                if trail then
                    trail.Color = ColorSequence.new(currentRgbColor)
                end
                local pl = part:FindFirstChild("CheatGlow")
                if pl then pl.Color = currentRgbColor end
            end
        end
    end

    if Options.AngelWingsToggle and Options.AngelWingsToggle.Value then
        local wingsModel = char:FindFirstChild("CustomAngelWingsModel")
        if wingsModel then
            for _, p in ipairs(wingsModel:GetChildren()) do
                if p:IsA("Part") then p.Color = currentRgbColor end
            end
        end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then
            local pl = torso:FindFirstChild("WingsGlow")
            if pl then pl.Color = currentRgbColor end
        end
    end

    -- Предикт полета предметов (Projectile Prediction)
    if Options.PredictionToggle and Options.PredictionToggle.Value then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle") or char.HumanoidRootPart
            local pos = handle.Position
            local speed = 75
            local vel = Camera.CFrame.LookVector * speed + Vector3.new(0, 20, 0)
            local g = Vector3.new(0, -Workspace.Gravity, 0)
            
            for i, dot in ipairs(predictionDots) do
                local t = i * 0.07
                local p = pos + vel * t + 0.5 * g * t * t
                local ray = Workspace:Raycast(p - vel * 0.07, vel * 0.07)
                if ray then
                    dot.Position = ray.Position
                    dot.Transparency = 0
                    for j = i + 1, #predictionDots do predictionDots[j].Transparency = 1 end
                    break
                else
                    dot.Position = p
                    dot.Transparency = (i / #predictionDots) * 0.4
                end
            end
        else
            for _, dot in ipairs(predictionDots) do dot.Transparency = 1 end
        end
    else
        for _, dot in ipairs(predictionDots) do dot.Transparency = 1 end
    end

    local hrpPos = char.HumanoidRootPart.Position
    local ct = tick()
    
    for i = 1, #petals_pool do
        local data = petals_pool[i]
        if data and data.Part and data.Part.Parent then
            local dist = (data.Part.Position - hrpPos).Magnitude
            if data.Part.Position.Y < (hrpPos.Y - 12) or dist > 140 or (ct - data.SpawnTime) > 6.0 then
                resetPetal(data.Part, hrpPos)
                data.SpawnTime = ct
            end
        end
    end
end)

