local function drawLightningBolt(startPos, endPos, color)
    local segments = 8
    local lastPos = startPos
    for i = 1, segments do
        local progress = i / segments
        local offset = Vector3.new(math.random(-5, 5), math.random(-2, 2), math.random(-5, 5))
        if i == segments then offset = Vector3.new(0,0,0) end
        local targetPos = startPos:Lerp(endPos, progress) + offset
        
        local segPart = Instance.new("Part", MainFolder)
        segPart.Size = Vector3.new(0.3, 0.3, (targetPos - lastPos).Magnitude)
        segPart.CFrame = CFrame.new(lastPos:Lerp(targetPos, 0.5), targetPos)
        segPart.Color = color
        segPart.Material = Enum.Material.Neon
        segPart.Anchored = true
        segPart.CanCollide = false
        game:GetService("Debris"):AddItem(segPart, 0.4)
        lastPos = targetPos
    end
    local lightPart = Instance.new("Part", MainFolder)
    lightPart.Position = endPos
    lightPart.Transparency = 1
    lightPart.Anchored = true
    lightPart.CanCollide = false
    local pl = Instance.new("PointLight", lightPart)
    pl.Color = color
    pl.Range = 40
    pl.Brightness = 8
    game:GetService("Debris"):AddItem(lightPart, 0.3)
end

