            if p ~= LocalPlayer and (string.lower(string.sub(p.Name, 1, #Value)) == string.lower(Value) or string.lower(string.sub(p.DisplayName, 1, #Value)) == string.lower(Value)) then
                CurrentTarget = p
                Fluent:Notify({ Title = "Target Found", Content = "Цель: " .. p.Name, Duration = 3 })
                return
            end
        end
        CurrentTarget = nil
        Fluent:Notify({ Title = "Error", Content = "Игрок не найден", Duration = 3 })
    end
})
