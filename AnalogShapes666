local function MonitorPlayer(player)
    if player == LocalPlayer then return end
    local function onCharacterAdded(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            local lastHp = hum.Health
            hum.HealthChanged:Connect(function(newHp)
                if newHp < lastHp then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                        if (char.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude < 150 then
                            PlayHitSound()
                        end
                    end
                end
                lastHp = newHp
            end)
            
            hum.Died:Connect(function()
                local creatorTag = char:FindFirstChild("creator")
                local isMyKill = false
                if creatorTag and creatorTag.Value == LocalPlayer then
                    isMyKill = true
                else
                    local myChar = LocalPlayer.Character
                    if myChar and myChar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                        if (char.HumanoidRootPart.Position - myChar.HumanoidRootPart.Position).Magnitude < 45 then
                            isMyKill = true
                        end
                    end
                end
                
                if isMyKill then
                    TriggerKillEffects()
                end
            end)
        end
    end
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do MonitorPlayer(p) end
