local flyBodyVelocity, flyBodyGyro
local function CleanFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.PlatformStand = false
    end
end
Options.FlyToggle:OnChanged(function(Value) if not Value then CleanFly() end end)

local ActiveHudTarget = nil
local HudShowTime = 0
local lastTargetHp = 100
local lastHudTarget = nil

local function ShowTargetHudFor(player, duration)
    if not player or not player.Character then return end
    local hum = player.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end
    ActiveHudTarget = player
    HudShowTime = os.clock() + duration
end

local function MonitorPlayerHealth(player)
    if player == LocalPlayer then return end
    local function onCharacterAdded(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            local lastHp = hum.Health
            hum.HealthChanged:Connect(function(newHp)
                if newHp < lastHp then
                    if Options.TargetHUDToggle and Options.TargetHUDToggle.Value then
                        ShowTargetHudFor(player, 3)
                    end
                end
                lastHp = newHp
            end)
        end
    end
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do MonitorPlayerHealth(p) end
Players.PlayerAdded:Connect(MonitorPlayerHealth)

local smoothedPosition = nil

RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    
    if Options.ClockTimeSlider then Lighting.ClockTime = Options.ClockTimeSlider.Value end
    if Options.AmbientColorPicker then Lighting.Ambient = Options.AmbientColorPicker.Value end
    if Options.OutdoorAmbientColorPicker then Lighting.OutdoorAmbient = Options.OutdoorAmbientColorPicker.Value end
    
    if Options.FovToggle and Options.FovToggle.Value then
        Camera.FieldOfView = Options.FOVValue.Value
    end
    
    -- ИСПРАВЛЕННЫЙ ASPECT RATIO (без сброса углов через CFrame.fromMatrix)
    if Options.AspectToggle and Options.AspectToggle.Value then
        local scaleX = Options.AspectX and Options.AspectX.Value or 1
        local scaleY = Options.AspectY and Options.AspectY.Value or 0.65
        local cf = Camera.CFrame
        Camera.CFrame = CFrame.fromMatrix(cf.Position, cf.RightVector * scaleX, cf.UpVector * scaleY, -cf.LookVector)
    end
    
    if Options.SmoothCamToggle and Options.SmoothCamToggle.Value then
        local camera = Workspace.CurrentCamera
        if camera then
            local target = camera.CFrame
            
            local speed = 0
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                speed = root.AssemblyLinearVelocity.Magnitude
            end
            
            local teleportDist = Options.SmoothCamTeleport and Options.SmoothCamTeleport.Value or 50
            if not smoothedPosition or (target.Position - smoothedPosition).Magnitude > teleportDist then
                smoothedPosition = target.Position
            end
            
            local baseSmoothness = Options.SmoothCamSmoothness and Options.SmoothCamSmoothness.Value or 5
            local speedFactor = Options.SmoothCamSpeedFactor and Options.SmoothCamSpeedFactor.Value or 0.5
            local maxLag = Options.SmoothCamMaxLag and Options.SmoothCamMaxLag.Value or 2.5
            
            local dynamicSmoothness = baseSmoothness + speed * speedFactor
            local alpha = 1 - math_exp(-dynamicSmoothness * deltaTime)
            smoothedPosition = smoothedPosition:Lerp(target.Position, alpha)
            
            local offset = smoothedPosition - target.Position
            if offset.Magnitude > maxLag then
                smoothedPosition = target.Position + offset.Unit * maxLag
            end
            
            camera.CFrame = CFrame.new(smoothedPosition) * target.Rotation
        end
    else
        smoothedPosition = nil
    end

    -- ХИТБОКСЫ С УЧЕТОМ WHILTELIST
    if Options.HitboxToggle and Options.HitboxToggle.Value then
        local targetSize = Options.HitboxSize.Value
        local targetTrans = Options.HitboxTrans.Value
        local targetColor = Options.HitboxColor.Value
        local teamCheck = Options.TeamCheckToggle.Value
        
        for _, player in ipairs(cachedPlayers) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local tHum = player.Character:FindFirstChild("Humanoid")
                local hrp = player.Character.HumanoidRootPart
                
                -- Проверка на вайтлист (по нику или DisplayName)
                local isWhitelisted = HitboxWhitelist[player.Name] or HitboxWhitelist[player.DisplayName]

                if tHum and tHum.Health > 0 and not isWhitelisted then
                    if teamCheck and player.Team == LocalPlayer.Team then
                        if hrp.Size ~= Vector3.new(2, 2, 1) then
                            hrp.Size = Vector3.new(2, 2, 1)
                            hrp.Transparency = 1
                        end
                    else
                        hrp.Size = Vector3.new(targetSize, targetSize, targetSize)
                        hrp.Transparency = targetTrans
                        hrp.Color = targetColor
                        hrp.CanCollide = false
                    end
                else
                    if hrp.Size ~= Vector3.new(2, 2, 1) then
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                    end
                end
            end
        end
    else
        for _, player in ipairs(cachedPlayers) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                if hrp.Size.X > 2 then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end

    -- ЧАМСЫ (НЕ ЗАТРАГИВАЮТ HumanoidRootPart, ЧТОБЫ НЕ ПЕРЕСЕКАТЬСЯ С ХИТБОКСАМИ)
    for _, player in ipairs(cachedPlayers) do
        if player ~= LocalPlayer and player.Character then
            local ch = player.Character
            local chamsEnabled = Options.ChamsToggle and Options.ChamsToggle.Value
            
            for _, part in ipairs(ch:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    local adornment = part:FindFirstChild("CustomChamsAdornment")
                    if chamsEnabled then
                        if not adornment then
                            adornment = Instance.new("BoxHandleAdornment")
                            adornment.Name = "CustomChamsAdornment"
                            adornment.Adornee = part
                            adornment.AlwaysOnTop = true
                            adornment.ZIndex = 10
                            adornment.Parent = part
                        end
                        adornment.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
                        adornment.Color3 = Options.ChamsColor and Options.ChamsColor.Value or Color3.fromRGB(150, 50, 255)
                        adornment.Transparency = Options.ChamsTrans and Options.ChamsTrans.Value or 0.5
                    else
                        if adornment then
                            adornment:Destroy()
                        end
                    end
                end
            end
        end
    end

    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local targetActive = false
    if Options.TargetStrafeToggle and Options.TargetStrafeToggle.Value and CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
        local tHrp = CurrentTarget.Character.HumanoidRootPart
        local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
        
        if tHum and tHum.Health > 0 then
            targetActive = true
            local radius = Options.TargetRadius.Value
            local speed = Options.TargetSpeed.Value
            
            TargetStrafeAngle = TargetStrafeAngle + math_rad(speed) * (deltaTime * 60)
            local offset = Vector3.new(math_cos(TargetStrafeAngle) * radius, 0, math_sin(TargetStrafeAngle) * radius)
            local targetPos = tHrp.Position + offset
            
            hrp.CFrame = CFrame.new(targetPos, tHrp.Position)
            ShowTargetHudFor(CurrentTarget, 0.1)
        end
    end

    if Options.TargetHUDToggle and Options.TargetHUDToggle.Value then
        local mouseTarget = Mouse.Target
        if mouseTarget then
            local model = mouseTarget:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChild("Humanoid") then
                local hoveredPlayer = Players:GetPlayerFromCharacter(model)
                if hoveredPlayer and hoveredPlayer ~= LocalPlayer then
                    ShowTargetHudFor(hoveredPlayer, 0.15)
                end
            end
        end
    end

    if Options.TargetHUDToggle and Options.TargetHUDToggle.Value and ActiveHudTarget and ActiveHudTarget.Character and os.clock() < HudShowTime then
        local tHum = ActiveHudTarget.Character:FindFirstChild("Humanoid")
        if tHum and tHum.Health > 0 then
            TargetHudFrame.Visible = true
            TargetNameText.Text = ActiveHudTarget.DisplayName .. " (@" .. ActiveHudTarget.Name .. ")"
            
            if lastHudTarget ~= ActiveHudTarget then
                lastTargetHp = tHum.Health
                lastHudTarget = ActiveHudTarget
            end
            
            local hpPercent = tHum.Health / tHum.MaxHealth
            TweenService:Create(HpFill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(hpPercent, 0, 1, 0)}):Play()
            
            if tHum.Health < lastTargetHp then
                HpPulse.BackgroundTransparency = 0.2
                TweenService:Create(HpPulse, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
            end
            lastTargetHp = tHum.Health
        else
            TargetHudFrame.Visible = false
        end
    else
        TargetHudFrame.Visible = false
    end

    if not targetActive then
        -- ОБРАБОТКА ФУНКЦИИ SPEED С ТРЕМЯ МЕХАНИКАМИ
        if Options.SpeedToggle and Options.SpeedToggle.Value and not Options.FlyToggle.Value and not Options.StrafeToggle.Value then
            local speedVal = Options.SpeedSlider.Value
            local mode = Options.SpeedMode.Value
            local moveDir = hum.MoveDirection

            if mode == "Velocity" then
                -- 1. Механика через Velocity
                if moveDir.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * speedVal, hrp.AssemblyLinearVelocity.Y, moveDir.Z * speedVal)
                end
            elseif mode == "CFrame" then
                -- 2. Механика через CFrame
                if moveDir.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (moveDir * (speedVal * deltaTime))
                end
            elseif mode == "Bypass (Micro-Step)" then
                -- 3. Механика Спидхака на ваш выбор (Микротелепорт / Импульс обхода античита)
                if moveDir.Magnitude > 0 then
                    local stepDistance = (speedVal * 0.75) * deltaTime
                    hrp.CFrame = hrp.CFrame + (moveDir * stepDistance)
                    hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * (speedVal * 0.5), hrp.AssemblyLinearVelocity.Y, moveDir.Z * (speedVal * 0.5))
                end
            end
        end

        if Options.FlyToggle and Options.FlyToggle.Value then
            hum.PlatformStand = true
            local animator = hum:FindFirstChild("Animator")
            if animator then for _, anim in pairs(animator:GetPlayingAnimationTracks()) do anim:Stop() end end

            if not flyBodyVelocity then
                flyBodyVelocity = Instance.new("BodyVelocity", hrp); flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBodyGyro = Instance.new("BodyGyro", hrp); flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9); flyBodyGyro.P = 9e4
            end

            flyBodyGyro.CFrame = Camera.CFrame
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            flyBodyVelocity.Velocity = moveDir * Options.FlySpeed.Value
        end

        if not Options.FlyToggle.Value then
            local isMoving = hum.MoveDirection.Magnitude > 0
            if Options.StrafeToggle and Options.StrafeToggle.Value and isMoving then
                local speed = Options.StrafeSpeed.Value
                local moveDir = hum.MoveDirection
                
                local isAirborne = hum:GetState() == Enum.HumanoidStateType.Freefall
                if isAirborne and Options.StrafeAirMult then
                    speed = speed * Options.StrafeAirMult.Value
                end
                
                local ray = Workspace:Raycast(hrp.Position, moveDir * 3)
                if ray and ray.Instance and ray.Instance.CanCollide then
                    speed = speed * 0.2
                end
                
                hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * speed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * speed)
            end
            if Options.QuickStopToggle and Options.QuickStopToggle.Value and not isMoving then
                local stopPower = Options.QuickStopPower.Value / 100
                local currentVel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = currentVel:Lerp(Vector3.new(0, currentVel.Y, 0), stopPower)
            end
        end
    end
end)

